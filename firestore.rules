rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the operator account may read, change or delete tickets.
    // It is matched by its Firebase Authentication User UID. If the
    // operator account is ever deleted and re-created, this UID changes
    // and must be updated here, then the rules re-published.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == '9J124ZOTMLVqyhvHpa11Cf7AaX13';
    }

    // PRIVATE customer data (names, phones, emails, notes).
    // The public can only CREATE a ticket. Only the operator can read/change/delete.
    match /tickets/{ticketId} {
      allow create: if ticketId.matches('AGMS-[0-9]{8}')
        && request.resource.data.keys().hasOnly([
             'id','name','phone','wa','email','brand','model','faults',
             'faultNotes','channel','date','time','stage','status',
             'benchNotes','price','warranty','createdAt'])
        && request.resource.data.keys().hasAll([
             'id','name','phone','wa','email','brand','model','faults',
             'faultNotes','channel','date','time','status','createdAt'])
        && request.resource.data.id == ticketId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('[^@ ]+@[^@ ]+[.][^@ ]+')
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && request.resource.data.wa is string
        && request.resource.data.wa.size() <= 30
        && request.resource.data.brand is string
        && request.resource.data.brand.size() <= 100
        && request.resource.data.model is string
        && request.resource.data.model.size() <= 150
        && request.resource.data.faults is list
        && request.resource.data.faults.size() >= 1
        && request.resource.data.faults.size() <= 12
        && request.resource.data.faultNotes is string
        && request.resource.data.faultNotes.size() <= 1000
        && request.resource.data.channel is string
        && request.resource.data.channel.size() <= 60
        && request.resource.data.date is string
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.time is string
        && request.resource.data.time.size() <= 40
        && request.resource.data.status == 'Pending'
        && request.resource.data.get('stage', 0) == 0
        && request.resource.data.get('benchNotes', '') == ''
        && request.resource.data.get('price', 0) == 0
        && request.resource.data.get('warranty', 90) == 90
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40;

      allow read, update, delete: if isAdmin();
    }

    // PUBLIC, non-personal status used by the "Track your repair" box.
    // Customers can read ONE record by exact ID (get) but can never list them.
    match /ticketStatus/{ticketId} {
      allow get: if true;
      allow list: if isAdmin();

      allow create: if ticketId.matches('AGMS-[0-9]{8}')
        && request.resource.data.keys().hasOnly(
             ['id','device','repair','status','date','time','createdAt'])
        && request.resource.data.keys().hasAll(
             ['id','device','repair','status','date','time','createdAt'])
        && request.resource.data.id == ticketId
        && request.resource.data.device is string
        && request.resource.data.device.size() <= 260
        && request.resource.data.repair is string
        && request.resource.data.repair.size() <= 400
        && request.resource.data.status == 'Pending'
        && request.resource.data.date is string
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.time is string
        && request.resource.data.time.size() <= 40
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40;

      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
